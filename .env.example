# PostgreSQL на том же VPS, что и Next.js. Никогда не открывайте порт БД наружу.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Отдельный случайный секрет, минимум 32 символа: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_HASH_SECRET=
# Публичный адрес после размещения, например https://ваш-домен.ru
SITE_URL=
# Необязательная публичная ссылка Telegram, не служебный chat_id
NEXT_PUBLIC_TELEGRAM_URL=
# Рабочая почта для контактов; пока по PRD используется hello@example.com
NEXT_PUBLIC_CONTACT_EMAIL=
